@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 10 10 11;
    --surface: 20 20 22;
    --border: 39 39 42;
    --primary: 0 220 130;
    --danger: 255 59 59;
    --warning: 255 184 0;
    --info: 0 150 255;
    --text: 250 250 250;
    --text-secondary: 161 161 169;
  }

  * {
    border-color: theme('colors.border');
  }

  body {
    @apply bg-background text-text antialiased;
    font-feature-settings: "rlig" 1, "calt" 1;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .glass {
    @apply backdrop-blur-md bg-surface/30 border;
    border-color: rgba(39, 39, 42, 0.5);
  }

  .glow {
    @apply shadow-2xl shadow-primary/20;
  }

  .tap-highlight-transparent {
    -webkit-tap-highlight-color: transparent;
  }
}

/* Custom animations */
.swipe-card {
  touch-action: none;
  will-change: transform;
}

.swipe-card.dragging {
  transition: none !important;
}

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Focus styles */
.focus-ring {
  @apply focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background;
}

/* Loading skeleton */
@keyframes shimmer {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}

.skeleton {
  animation: shimmer 2s infinite;
  background: linear-gradient(
    90deg,
    #141416 0%,
    #1f1f22 50%,
    #141416 100%
  );
  background-size: 1000px 100%;
}

/* Gradient text */
.gradient-text {
  @apply bg-gradient-to-r from-primary to-info bg-clip-text text-transparent;
}

/* Card stack shadows */
.card-stack-1 {
  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.3);
}

.card-stack-2 {
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.3);
}

.card-stack-3 {
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
}
