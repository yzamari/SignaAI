# SignaAI Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# API Keys (REQUIRED)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
STRIPE_API_KEY=your-stripe-api-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/signaai
REDIS_URL=redis://localhost:6379

# Security Keys (Generate new ones for production!)
SECRET_KEY=generate-a-secure-random-key-here
JWT_SECRET_KEY=generate-another-secure-random-key-here
ENCRYPTION_KEY=generate-32-byte-key-for-encryption

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5112
FRONTEND_URL=http://localhost:5173
DEBUG=false
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=1000

# Storage Configuration  
STORAGE_TYPE=local  # Options: local, s3, gcs
S3_BUCKET_NAME=
S3_REGION=
GCS_BUCKET_NAME=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@signaai.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=
LOG_LEVEL=info

# Feature Flags
ENABLE_AI_DETECTION=true
ENABLE_CACHING=true
ENABLE_WEBSOCKET=true
ENABLE_RATE_LIMITING=true

# AI Service Configuration
AI_PROVIDER=gemini  # Options: gemini, openai
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=1024