# OCR Service Configuration (Default for production)
# Using OCR with Computer Vision instead of AI service for better accuracy

# Field Detection Service - Using OCR with CV
FIELD_DETECTION_SERVICE_URL=http://localhost:8002
FIELD_DETECTION_PORT=8002

# OCR Service Configuration
OCR_SERVICE_ENABLED=true
OCR_SERVICE_PORT=8002
OCR_SERVICE_HOST=localhost

# Disable AI Service (can still run for comparison testing)
AI_SERVICE_ENABLED=false
AI_SERVICE_PORT=8001

# Language Support
OCR_LANGUAGES=heb+eng+ara+deu+fra+rus

# Computer Vision Settings
CV_LINE_DETECTION=true
CV_BOX_DETECTION=true
CV_MIN_FIELD_WIDTH=50
CV_MIN_FIELD_HEIGHT=15

# Service Selection
USE_OCR_FOR_FIELD_DETECTION=true
USE_AI_FOR_FIELD_DETECTION=false