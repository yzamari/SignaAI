# SignaAI Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://signa_user:signa_password_dev@localhost:5432/signa_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO/S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=signa_admin
MINIO_SECRET_KEY=signa_minio_password
MINIO_BUCKET_NAME=signa-documents
MINIO_SECURE=false

# Message Queue Configuration
RABBITMQ_URL=amqp://signa_user:signa_password@localhost:5672/

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@signa-ai.com

# SMS Configuration
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret

# AI/ML Configuration
AI_MODEL_PATH=./models
GOOGLE_AI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
AI_PROVIDER=gemini
CLOUD_PROVIDER=gcp

# Israeli Legal Compliance
DIGITAL_SIGNATURE_CERT_PATH=/path/to/certificate.p12
TIMESTAMP_SERVER_URL=https://timestamp.server.com