# SignaAI Microservices Environment Configuration
# Copy this file to .env and update with your values

# General
NODE_ENV=production
LOG_LEVEL=info

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=signaai
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_MULTIPLE_DATABASES=auth_db,document_db,signature_db,notification_db,workflow_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT Authentication
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 (for document storage)
S3_BUCKET=signaai-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@signaai.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
APNS_KEY_ID=your_apple_push_notification_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.signaai.app

# Certificate Store (for digital signatures)
CERTIFICATE_STORE_URL=https://cert.signaai.com
CERTIFICATE_API_KEY=your_certificate_api_key

# OCR Service
OCR_SERVICE_URL=http://ocr-service:8002
OCR_API_KEY=internal_ocr_key

# Service URLs (internal communication)
AUTH_SERVICE_URL=http://auth-service:5001
DOCUMENT_SERVICE_URL=http://document-service:5002
SIGNATURE_SERVICE_URL=http://signature-service:5003
NOTIFICATION_SERVICE_URL=http://notification-service:5004
WORKFLOW_SERVICE_URL=http://workflow-service:5005

# API Gateway
API_GATEWAY_PORT=5100
RATE_LIMIT_WINDOW=15min
RATE_LIMIT_MAX_REQUESTS=100

# Service Discovery
SERVICE_REGISTRY_URL=http://service-registry:5010
SERVICE_HEARTBEAT_INTERVAL=30000

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=signaai
RABBITMQ_PASS=password

# Security
CORS_ORIGIN=http://localhost:3001,https://app.signaai.com
HELMET_ENABLED=true
CSRF_SECRET=your_csrf_secret_here

# Feature Flags
ENABLE_BIOMETRIC_SIGNATURES=false
ENABLE_BLOCKCHAIN_VERIFICATION=false
ENABLE_AI_FIELD_DETECTION=true

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/signaai
LOG_MAX_SIZE=10m
LOG_MAX_FILES=10

# Performance
MAX_FILE_SIZE=50MB
CONCURRENT_WORKERS=4
QUEUE_CONCURRENCY=5
DB_CONNECTION_POOL_SIZE=10

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=signaai-backups

# Compliance
ENABLE_AUDIT_LOG=true
DATA_RETENTION_DAYS=2555
GDPR_COMPLIANCE_MODE=true

# Development/Testing
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_ENDPOINTS=false
SEED_TEST_DATA=false