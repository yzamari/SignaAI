# Workflow Service Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Service URLs
DOCUMENT_SERVICE_URL=http://localhost:3001
SIGNATURE_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
AUDIT_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL=http://localhost:3000

# Database Configuration (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/workflow_db
DATABASE_POOL_SIZE=10

# Redis Configuration (for distributed caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Message Queue Configuration
RABBITMQ_URL=amqp://localhost:5672
QUEUE_NAME=workflow_events

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Feature Flags
ENABLE_SAGA_PATTERN=true
ENABLE_DEADLINE_MONITORING=true
ENABLE_AUTO_RETRY=true
MAX_RETRY_ATTEMPTS=3

# Performance Configuration
MAX_CONCURRENT_WORKFLOWS=100
STEP_EXECUTION_TIMEOUT=300000
WORKFLOW_TIMEOUT=86400000