    "@types/node": "^20.5.0",
    "@types/uuid": "^9.0.2",
    "@types/cors": "^2.8.13",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "winston": "^3.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.32.4",
    "form-data": "^4.0.0",
    "node-fetch": "^3.3.2",
    "sqlite3": "^5.1.6",
