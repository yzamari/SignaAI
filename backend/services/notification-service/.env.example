# Notification Service Environment Variables
# Copy this file to .env and configure with your settings

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_ENABLED=true
LOG_FILE_NAME=logs/notification-service.log
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=5

# Email Configuration (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=SignaAI
EMAIL_FROM_ADDRESS=noreply@signaai.com
EMAIL_RATE_LIMIT=60
EMAIL_TIMEOUT=30000

# SMS Configuration
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_FROM_NUMBER=+1234567890
SMS_RATE_LIMIT=30
SMS_TIMEOUT=10000

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# AWS SNS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Push Notification Configuration
PUSH_ENABLED=true
PUSH_RATE_LIMIT=120
PUSH_TIMEOUT=15000

# Firebase Cloud Messaging (FCM)
FCM_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project"}

# Apple Push Notification Service (APNS)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.yourapp.bundle
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_NAMESPACE=/notifications
WEBSOCKET_CORS_ORIGIN=*

# Queue Configuration
QUEUE_RETRY_STRATEGY=exponential
QUEUE_MAX_RETRIES=3
QUEUE_BASE_DELAY=1000
QUEUE_MAX_DELAY=60000
QUEUE_MULTIPLIER=2
QUEUE_INCREMENT=1000
QUEUE_INTERVAL=5000
QUEUE_MAX_SIZE=10000
QUEUE_BATCH_SIZE=10
QUEUE_PROCESSING_INTERVAL=1000

# Redis Configuration (Optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Alerting Configuration
ALERTING_ENABLED=true
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_RESPONSE_TIME_THRESHOLD=5000
ALERT_QUEUE_SIZE_THRESHOLD=1000

# Database Configuration (if implementing persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/notifications
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Authentication Configuration (if implementing auth)
# JWT_SECRET=your-jwt-secret
# JWT_EXPIRES_IN=24h

# External API Keys (if integrating with other services)
# WEBHOOK_SECRET=your-webhook-secret
# API_KEY=your-api-key