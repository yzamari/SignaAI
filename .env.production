# SignaAI Production Environment Configuration for GCP
# This file contains production environment variables for Google Cloud Platform deployment

# ===================================
# GCP Project Configuration
# ===================================
PROJECT_ID=signaai-prod
GOOGLE_CLOUD_PROJECT=signaai-prod
GCP_REGION=us-central1
GCP_ZONE=us-central1-c

# ===================================
# Service Configuration
# ===================================
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=info

# Service Ports (internal container ports)
BACKEND_PORT=8000
FRONTEND_PORT=3000
OCR_SERVICE_PORT=8000

# ===================================
# Database Configuration (Cloud SQL)
# ===================================
# Cloud SQL PostgreSQL connection
DB_HOST=/cloudsql/signaai-prod:us-central1:signaai-db
DB_NAME=signaai_prod
DB_USER=signaai_user
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_PORT=5432

# Database URL for SQLAlchemy (using Cloud SQL Proxy)
DATABASE_URL=postgresql://signaai_user:REPLACE_WITH_SECURE_PASSWORD@/signaai_prod?host=/cloudsql/signaai-prod:us-central1:signaai-db

# ===================================
# Redis Configuration (Memorystore)
# ===================================
REDIS_HOST=10.0.0.3
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@10.0.0.3:6379

# ===================================
# Google Cloud Storage Configuration
# ===================================
GCS_BUCKET_NAME=signaai-prod-documents
GCS_BUCKET_UPLOADS=signaai-prod-uploads
GCS_BUCKET_TEMP=signaai-prod-temp
STORAGE_TYPE=gcs

# ===================================
# Service URLs (Cloud Run services)
# ===================================
BACKEND_URL=https://signaai-backend-hash-uc.a.run.app
FRONTEND_URL=https://signaai-frontend-hash-uc.a.run.app
OCR_SERVICE_URL=https://signaai-ocr-hash-uc.a.run.app

# Frontend environment variables
NEXT_PUBLIC_API_URL=https://signaai-backend-hash-uc.a.run.app
NEXT_PUBLIC_OCR_URL=https://signaai-ocr-hash-uc.a.run.app
NEXT_PUBLIC_OCR_SERVICE_URL=https://signaai-ocr-hash-uc.a.run.app
VITE_API_URL=https://signaai-backend-hash-uc.a.run.app
VITE_OCR_SERVICE_URL=https://signaai-ocr-hash-uc.a.run.app

# ===================================
# External API Keys & Services
# ===================================

# Gemini AI Configuration
GEMINI_API_KEY=AIzaSyCtw5XG_XTbxxNRajkbGWj9feoaqwFoptA
VITE_GEMINI_API_KEY=AIzaSyCtw5XG_XTbxxNRajkbGWj9feoaqwFoptA
GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# Twilio Configuration (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=ACb1bd54f64f271b238a948225a0e67efa
TWILIO_AUTH_TOKEN=1a7679082f7ae414de5bd241eae71289
TWILIO_PHONE_NUMBER=+19342273609
TWILIO_WHATSAPP_NUMBER=whatsapp:+19342273609
TWILIO_PHONE_TO=+972523121682,+972542363473

# Payment Configuration (Production)
STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_LIVE_KEY
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
PAYPAL_CLIENT_ID=REPLACE_WITH_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_LIVE_CLIENT_SECRET
PAYPAL_MODE=live

# ===================================
# Security Configuration
# ===================================

# JWT & Security Keys (MUST BE CHANGED FOR PRODUCTION)
SECRET_KEY=REPLACE_WITH_SECURE_32_CHAR_SECRET_KEY_FOR_PRODUCTION
JWT_SECRET_KEY=REPLACE_WITH_SECURE_JWT_SECRET_KEY_32_CHARS_MIN
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration for production
ALLOWED_ORIGINS=["https://signaai-frontend-hash-uc.a.run.app", "https://app.signaai.com", "https://signaai.com"]

# ===================================
# Google Cloud Specific Configuration
# ===================================

# Secret Manager secrets (will be injected at runtime)
# These reference secrets stored in Google Secret Manager
DB_PASSWORD_SECRET=projects/signaai-prod/secrets/db-password/versions/latest
JWT_SECRET_SECRET=projects/signaai-prod/secrets/jwt-secret/versions/latest
REDIS_PASSWORD_SECRET=projects/signaai-prod/secrets/redis-password/versions/latest

# Service Account for application
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/google/key.json

# Cloud Storage bucket permissions
STORAGE_CREDENTIALS_PATH=/var/secrets/google/storage-key.json

# ===================================
# Monitoring & Logging
# ===================================

# Google Cloud Logging
GOOGLE_CLOUD_LOGGING_ENABLED=true
LOG_NAME=signaai-application-logs

# Google Cloud Monitoring
GOOGLE_CLOUD_MONITORING_ENABLED=true

# Error Reporting
GOOGLE_CLOUD_ERROR_REPORTING_ENABLED=true

# ===================================
# Performance & Scaling
# ===================================

# Worker configuration for production
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
TIMEOUT=120
KEEP_ALIVE=5

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ===================================
# Feature Flags
# ===================================

# Enable production features
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_CACHING=true
ENABLE_BACKGROUND_TASKS=true

# Disable development features
ENABLE_DEBUG_LOGGING=false
ENABLE_HOT_RELOAD=false
ENABLE_DEVELOPMENT_TOOLS=false

# ===================================
# Health Checks & Readiness
# ===================================

# Health check endpoints
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready

# Startup probe configuration
STARTUP_PROBE_INITIAL_DELAY=60
STARTUP_PROBE_PERIOD=10
STARTUP_PROBE_TIMEOUT=5
STARTUP_PROBE_FAILURE_THRESHOLD=6

# ===================================
# SSL/TLS Configuration
# ===================================

# SSL is handled by Cloud Run automatically
SSL_ENABLED=true
FORCE_HTTPS=true

# ===================================
# Backup & Data Retention
# ===================================

# Database backup configuration
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
DB_BACKUP_RETENTION_DAYS=30

# Document storage backup
STORAGE_BACKUP_ENABLED=true
STORAGE_BACKUP_RETENTION_DAYS=90